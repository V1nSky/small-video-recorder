#!/bin/zsh
set -e
cd "$(dirname "$0")"

source ./config.env
mkdir -p "$OUT_DIR" logs state

PID_FILE="state/record.pid"
OUT_FILE_STATE="state/current_output.txt"

if [ -f "$PID_FILE" ]; then
  PID=$(cat "$PID_FILE")
  if kill -0 "$PID" 2>/dev/null; then
    echo "Already recording. PID: $PID"
    echo "Output: $(cat "$OUT_FILE_STATE" 2>/dev/null)"
    exit 0
  fi
fi

STAMP=$(date +"%Y-%m-%d_%H-%M-%S")
OUT="$OUT_DIR/screen_$STAMP.mp4"
INPUT="$SCREEN_DEVICE:$AUDIO_DEVICE"

# Start detached. Terminal can be closed after this.
nohup ffmpeg \
  -hide_banner -y \
  -f avfoundation \
  -framerate "$FPS" \
  -capture_cursor "$CAPTURE_CURSOR" \
  -capture_mouse_clicks "$CAPTURE_MOUSE_CLICKS" \
  -i "$INPUT" \
  -c:v libx264 \
  -preset "$PRESET" \
  -crf "$CRF" \
  -pix_fmt yuv420p \
  -c:a aac \
  -b:a "$AUDIO_BITRATE" \
  "$OUT" > logs/current.log 2>&1 &

PID=$!
echo "$PID" > "$PID_FILE"
echo "$OUT" > "$OUT_FILE_STATE"

echo "Recording started in background."
echo "PID: $PID"
echo "Output: $OUT"
echo "You can close Terminal now."
echo "To stop later: ./record-stop"
