# mac-bg-recorder config
# First run: ./devices and put correct indexes here.
# Example ffmpeg input format is SCREEN_DEVICE:AUDIO_DEVICE, e.g. 1:0
SCREEN_DEVICE="1"
AUDIO_DEVICE="0"

FPS="30"
CRF="23"
PRESET="veryfast"
AUDIO_BITRATE="160k"
CAPTURE_CURSOR="1"
CAPTURE_MOUSE_CLICKS="0"

OUT_DIR="$HOME/Desktop/Records"
